\usepackage[acronym, nopostdot, nonumberlist]{glossaries}
\usepackage{glossaries-prefix}
\setacronymstyle{long-short}
% \setglossarystyle{index}
\makeglossaries

\makeatletter
\let\acrfull@orig\acrfull
\renewcommand{\acrfull}[1]{\acrfull@orig{#1}\glsunset{#1}}
\makeatother

%% General QFT
\newacronym[longplural={quantum field theories}, description={Quantum Field Theory}]{qft}{QFT}{quantum field theory}
\newacronym[description={Ultraviolet (Divergence)}, prefixfirst={an\ }, prefix={a\ }]{uv}{UV}{ultraviolet}
\newacronym[description={Infrared (Divergence)}]{ir}{IR}{infrared}
\newacronym[description={Parton Distribution Function}]{pdf}{PDF}{parton distribution function}
\newacronym[description=Irreducible Representation]{irrep}{irrep}{irreducible representation}
\newacronym[description={Minimal Subtraction}]{ms}{MS}{minimal subtraction}
\newacronym[description={Modified Minimal Subtraction}, sort={msbar}]{msbar}{$\overline{\text{MS}}$}{modified minimal subtraction}
\newacronym[description={Leading Order}]{lo}{LO}{leading order}
\newacronym[description={Next-to-Leading Order}]{nlo}{NLO}{next-to-leading order}
\newacronym[description={Next-to-Next-to-Leading Order}]{nnlo}{NNLO}{next-to-next-to-leading order}
% \newacronym[description={Leading Power at Next-to-Leading Logarithmic}]{lpnll}{LP NLL}{leading power at next-to-leading logarithmic}
% \newacronym[description={Next-to-Leading Power at Leading Logarithmic}]{nlpll}{NLP LL}{next-to-leading power at leading logarithmic}
\newacronym[description={Leading Power}]{lp}{LP}{leading power}
\newacronym[description={Next-to-Leading Power}]{nlp}{NLP}{next-to-leading power}
\newacronym[description={Leading Logarithmic}]{ll}{LL}{leading logarithmic}
\newacronym[description={Next-to-Leading Logarithmic}]{nll}{NLL}{next-to-leading logarithmic}
\newacronym[description={One-Particle Irreducible}]{1pi}{1PI}{one-particle irreducible}
\newacronym[description={Naive Dimensional Regularization}]{ndr}{NDR}{naive dimensional regularization}

%% Standard model
\newacronym[description={Standard Model}]{sm}{SM}{standard model}
\newacronym[description={Quantum Electrodynamics}]{qed}{QED}{quantum electrodynamics}
\newacronym[description={Quantum Chromodynamics}]{qcd}{QCD}{quantum chromodynamics}
\newacronym[description={Vacuum Expectation Value}]{vev}{vev}{vacuum expectation value}
\newacronym[description={Beyond the Standard Model}]{bsm}{BSM}{beyond the standard model}

%% Cosmology
\newacronym[description={Dark Matter}]{dm}{DM}{dark matter}
\newacronym[description={Weakly Interacting Massive Particle}]{wimp}{WIMP}{weakly interacting massive particle}
\newacronym[description={Cosmic Microwave Background}]{cmb}{CMB}{cosmic microwave background}

%% Kinematics
\newacronym[description={Center-of-Mass}]{com}{COM}{center-of-mass}
\newacronym[description={Rest Frame}]{rf}{RF}{rest frame}
\newacronym[description={Degrees of Freedom}]{dof}{d.o.f.}{degrees of freedom}


%% Supersymmetry
\newacronym[description={Minimal Supersymmetric Standard Model}]{mssm}{MSSM}{minimal supersymmetric standard model}
\newacronym[description={Lightest Supersymmetric Particle}]{lsp}{LSP}{lightest supersymmetric particle}

%% Experimental physics
\newacronym[description={Large Hadron Collider}]{lhc}{LHC}{large hadron collider}
\newacronym[description={Large Electron--Positron Collider}]{lep}{LEP}{large electron--positron collider}
\newacronym[description={Future Circular Collider}]{fcc}{FCC}{future circular collider}