\usepackage[acronym, nopostdot, nonumberlist]{glossaries}
\setacronymstyle{long-short}
% \setglossarystyle{index}
\makeglossaries

%% General QFT
\newacronym[longplural={quantum field theories}, description={Quantum Field Theory}]{qft}{QFT}{quantum field theory}
\newacronym[description={Standard Model}]{sm}{SM}{standard model}
\newacronym[description={Quantum Electrodynamics}]{qed}{QED}{quantum electrodynamics}

%% Kinematics
\newacronym[description={Rest Frame}]{rf}{RF}{rest frame}
% \newacronym[description={Centre of Mass}]{com}{COM}{centre of mass}
% \newacronym[description={Independent Kinematic Variable}]{ikv}{IKV}{independent kinematic variable}

%% Feynman diagrams
\newacronym[description={Leading Order}]{lo}{LO}{leading order}
\newacronym[description={Next-to-Leading Order}]{nlo}{NLO}{next-to-leading order}



\begin{comment}
    Note to self:
    \gls{} gives the acronym (or full expression the first time it appears.
    \Gls{} does the same, but capitalised.
    \glspl{}, \Glspl{} do the same, but plural versions.
