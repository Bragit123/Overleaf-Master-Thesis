%%% Note to self: Remember the difference between \newcommand and \DeclareMathOperator.

%% The mathabx.sty definition of \widebar (stolen from Carl Martin)
\DeclareFontFamily{U}{mathx}{\hyphenchar\font45}
\DeclareFontShape{U}{mathx}{m}{n}{
  <5> <6> <7> <8> <9> <10>
  <10.95> <12> <14.4> <17.28> <20.74> <24.88>
  mathx10
}{}
\DeclareSymbolFont{mathx}{U}{mathx}{m}{n}
\DeclareFontSubstitution{U}{mathx}{m}{n}
\DeclareMathAccent{\widebar}{0}{mathx}{"73}


%% Sizes (stolen from stackexchange)
% https://tex.stackexchange.com/questions/6794/about-big-parenthesis-larger-than-bigg/6796#6796
\makeatletter
\newcommand*{\vast}{\bBigg@{3}}
\newcommand*{\vastl}{\mathopen\vast}
\newcommand*{\vastr}{\mathclose\vast}
\makeatother


%% Notation redefinitions
\renewcommand*{\vec}[1]{\boldsymbol{#1}}


%% Operators
\renewcommand{\Re}{\operatorname{Re}}
\renewcommand{\Im}{\operatorname{Im}}
\DeclareMathOperator{\Tr}{Tr}
\DeclareMathOperator{\Rot}{Rot}
\DeclareMathOperator{\Boost}{Boost}


%% Useful math shorthands
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\newcommand*{\ex}{\vec{\hat{x}}}
\newcommand*{\ey}{\vec{\hat{y}}}
\newcommand*{\ez}{\vec{\hat{z}}}


%% Matrix elements
\newcommand*{\M}{\mathcal{M}}



%% Z-boson couplings
\newcommand{\chiralgamma}{\ensuremath{\zql(1-\gamma^5) + \zqr(1+\gamma^5)}}
\newcommand*{\zql}{Z_{q_L}}
\newcommand*{\zqr}{Z_{q_R}}
\newcommand*{\zliab}{Z_{\ell_i}^{AB}}
\newcommand*{\znuiab}{Z_{\tilde\nu_i}^{AB}}

\newcommand*{\fqliab}{F_{q\ell_i}^{AB}}


%% QFT shorthands
\newcommand*{\slepton}{{\tilde{\ell}}}
\newcommand*{\amp}{\mathcal{M}}
\newcommand*{\varepsilonIR}{\varepsilon_{\mathrm{IR}}}
\newcommand*{\varepsilonUV}{\varepsilon_{\mathrm{UV}}}


%% Kinematics shorthands
\newcommand*{\shat}{\hat{s}}
\newcommand*{\that}{\hat{t}}
\newcommand*{\uhat}{\hat{u}}
\newcommand*{\sqrtshat}{\sqrt{\shat}}
\newcommand*{\kiabs}{\abs{\vec{k}_1^*}}
\newcommand*{\kabs}{\abs{\vec{k}}}
\newcommand*{\poneslash}{\slashed{p}{}_1}
\newcommand*{\ptwoslash}{\slashed{p}{}_2}
\newcommand*{\koneslash}{\slashed{k}{}_1}
\newcommand*{\ktwoslash}{\slashed{k}{}_2}
\newcommand*{\pislash}{\slashed{p}{}_i}
\newcommand*{\kislash}{\slashed{k}{}_i}
\newcommand*{\pslash}{\slashed{p}}
\newcommand*{\kslash}{\slashed{k}}
\newcommand*{\qslash}{\slashed{q}}

\newcommand*{\mt}{\tilde{m}}
\newcommand*{\xm}{x^-}
\newcommand*{\xp}{x^+}
\newcommand*{\xpm}{x^\pm}


%% Div
\newcommand*{\sw}{\ensuremath{s_W}}
\newcommand*{\cw}{\ensuremath{c_W}}
\newcommand*{\MSbar}{\ensuremath{\overline{\text{MS}}}}


%% Plus distributions
\newcommand*{\plusdist}{\Biggl( \frac{1}{1-z} \Biggr)_{\!\!+}}
\newcommand*{\plusdistlog}{\Biggl( \frac{\log(1-z)}{1-z} \Biggr)_{\!\!+}}
\newcommand*{\plusdistf}{\Biggl( \frac{f(z)}{1-z} \Biggr)_{\!\!+}}


%% Grassmann coordinates
\newcommand*{\thetafour}{\theta\theta\bar\theta\bar\theta}


%% Differential operators
\newcommand*{\lrpartial}[1]{\overset{\hspace{-0.5em}\leftrightarrow}{\partial_{#1}}}
\newcommand*{\lrpartialUpper}[1]{\overset{\hspace{-0.5em}\leftrightarrow}{\partial^{#1}}}


%% Dev commands
\newcommand*{\rednote}[1]{\textcolor{red}{[#1]}}