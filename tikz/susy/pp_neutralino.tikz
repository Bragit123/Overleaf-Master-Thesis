% \begin{feynman}
%     \begin{scope}[node distance=1.4cm]
%         \vertex [blob, minimum size=0.7cm] (blob) {};
%         \vertex [right=of blob] (midright);
%         \vertex [above=of midright, label=right:\(j\)] (j);
%         \vertex [above left=of blob, label=left:\(p\)] (p1);
%         \vertex [below left=of blob, label=left:\(p\)] (p2);
%         \vertex [above=0.4 of midright] (slt);
%         \vertex [above right=of slt, label=right:\(\ell^-\)] (lt);
%         \vertex [right=of slt, label=right:\(\tilde\chi_1^0\)] (chit);
%         \vertex [below=0.4 of midright] (slb);
%         \vertex [below right=of slb, label=right:\(\ell^+\)] (lb);
%         \vertex [right=of slb, label=right:\(\tilde\chi_1^0\)] (chib);
%     \end{scope}
%     \diagram*{
%         (blob) -- (j);
%         (p1) --[double distance=1.5pt] (blob);
%         (p1) --[fermion] (blob);
%         (p2) --[double distance=1.5pt] (blob);
%         (p2) --[fermion] (blob);
%         (blob) --[charged scalar, edge label=\(\slepton\)] (slt) --[plain, boson] (chit);
%         (blob) --[anti charged scalar, edge label'=\(\slepton^*\)] (slb) --[plain, boson] (chib);
%         (slt) --[fermion] (lt);
%         (slb) --[anti fermion] (lb);
%     };
% \end{feynman}
\begin{feynman}
    \begin{scope}[node distance=1.4cm]
        \vertex [blob, minimum size=0.7cm] (blob) {};
        \vertex [above right=of blob] (j);
        \vertex [above right=of blob, label=right:\(j\)] (j);
        \vertex [left=1.2 of blob] (left_blob);
        \vertex [above left=of blob, label=left:\(p\)] (p1);
        \vertex [below=0.4 of left_blob, label=left:\(p\)] (p2);
        %% Upper slepton
        \vertex [right=of blob] (slt);
        \vertex [above right=of slt, label=right:\(\ell^-\)] (lt);
        \vertex [right=of slt] (right_slt);
        \vertex [below=0.4 of right_slt, label=right:\(\tilde\chi_1^0\)] (chit);
        %% Lower slepton
        \vertex [below right=of blob] (slb);
        \vertex [right=of slb] (right_slb);
        \vertex [below=of slb] (below_slb);
        \vertex [below=0.4 of right_slb, label=right:\(\ell^+\)] (lb);
        \vertex [right=0.4 of below_slb, label=right:\(\tilde\chi_1^0\)] (chib);
    \end{scope}
    \diagram*{
        (blob) -- (j);
        (p1) --[double distance=1.5pt] (blob);
        (p1) --[fermion] (blob);
        (p2) --[double distance=1.5pt] (blob);
        (p2) --[fermion] (blob);
        (blob) --[charged scalar, edge label=\(\slepton\)] (slt) --[plain, boson] (chit);
        (blob) --[anti charged scalar, edge label'=\(\slepton^*\)] (slb) --[plain, boson] (chib);
        (slt) --[fermion] (lt);
        (slb) --[anti fermion] (lb);
    };
\end{feynman}