\begin{feynman}
    \begin{scope}[node distance=1.4cm]
        \vertex (v);
        \vertex [above left=of v] (t);
        \vertex [left=of t, label=left:\(q\)] (q);
        \vertex [below left=of v] (b);
        \vertex [left=of b, label=left:\(\bar{q}\)] (qbar);
        \vertex [right=of v, label=right:\(\gamma^*\)] (past);
    \end{scope}
    \diagram*{
        (q) --[fermion, momentum={[arrow style=teal]\(p_1\)}] (t);
        (t) --[fermion, momentum={[arrow style=Purple]\(k+p_1\)}] (v);
        (v) --[fermion, momentum={[arrow style=Purple]\(k-p_2\)}] (b);
        (b) --[fermion, reversed momentum={[arrow style=teal]\(p_2\)}] (qbar);
        (b) --[boson, momentum={[arrow style=Purple]\(k\)}] (t);
        (v) --[boson, momentum'={[arrow style=Bittersweet]\(q\)}] (past);
    };
\end{feynman}