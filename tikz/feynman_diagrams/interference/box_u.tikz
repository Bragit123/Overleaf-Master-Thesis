\begin{feynman}
    \begin{scope}[node distance=2.2cm]
        \vertex [label=left:\(q\)] (q);
        \vertex [right=0.9 of q] (tl);
        \vertex [below=of tl] (bl);
        \vertex [left=0.9 of bl, label=left:\(\widebar{q}\)] (qbar);
        \vertex [right=of tl] (tr);
        \vertex [right=1.4 of tr, label=right:\(\slepton_{iB}^*\)] (lB);
        \vertex [right=of bl] (br);
        \vertex [right=1.4 of br, label=right:\(\slepton_{iA}\)] (lA);
        \vertex (midr) at ($(lB)!0.5!(br)$);
    \end{scope}
    \diagram*{
        (q) --[fermion, momentum={[arrow style=PineGreen]\(p_1\)}] (tl)
        --[fermion, momentum'={[arrow style=Purple]\(k+p_1\)}] (bl)
        --[fermion, rmomentum={[arrow style=PineGreen]\(p_2\)}] (qbar);
        (tr) --[boson, edge label=\(\gamma/\gamma/Z\), momentum'={[arrow style=Purple]\(k\)}] (tl);
        (bl) --[boson, edge label=\(\gamma/Z/\gamma\), momentum'={[arrow style=Purple]\(k+p_1+p_2\)}] (br);
        (lB) --[charged scalar, rmomentum'={[arrow style=PineGreen]\(k_1\)}] (midr)
        --[scalar] (br)
        --[charged scalar, momentum={[arrow style=Purple]\(k+k_2\)}] (tr)
        --[scalar] (midr)
        --[charged scalar, momentum'={[arrow style=PineGreen]\(k_2\)}] (lA);
    };
\end{feynman}