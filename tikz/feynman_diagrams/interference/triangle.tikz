\begin{feynman}
    \begin{scope}[node distance=1.6cm]
        \vertex (vr);
        \vertex [above left=of vr] (t);
        \vertex [below left=of vr, label={[text=Purple]below right:\(k+p_1+p_2\)}] (b);
        \vertex [left=1.2 of t, label=left:\(q\)] (q);
        \vertex [left=1.2 of b, label=left:\(\bar{q}\)] (qbar);
        \vertex [above right=of vr, label=right:\(\slepton^*_{iB}\)] (lB);
        \vertex [below right=of vr, label=right:\(\slepton_{iA}\)] (lA);
        \vertex (midA) at ($(vr)!0.4!(lA)$);
        \vertex (midB) at ($(vr)!0.4!(lB)$);
    \end{scope}
    \diagram*{
        (q) --[fermion, momentum={[arrow style=teal]\(p_1\)}] (t)
        --[fermion, momentum'={[arrow style=Purple]\(k+p_1\)}] (b)
        --[fermion, rmomentum={[arrow style=teal]\(p_2\)}] (qbar);
        (b) --[boson, momentum'={[arrow style=Purple]}] (vr)
        --[boson, momentum'={[arrow style=Purple]\(k\)}] (t);
        (vr) --[anti charged scalar] (lB);
        (vr) --[charged scalar] (lA);
        (midB) --[opacity=0.0, momentum'={[arrow style=teal]\(k_1\)}] (lB);
        (midA) --[opacity=0.0, momentum={[arrow style=teal]\(k_2\)}] (lA);
    };
\end{feynman}