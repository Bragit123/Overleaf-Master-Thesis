\begin{feynman}
    \begin{scope}[node distance=1.4cm]
        \vertex (t);
        \vertex [above left=of t, label=left:\(q\)] (q);
        \vertex [below=of t] (b);
        \vertex [below left=of b, label=left:\(\bar{q}\)] (qbar);
        \vertex [above right=of t, label=right:\(\gamma\)] (p);
        \vertex [below right=of b, label=right:\(\gamma^*\)] (past);
        \vertex (midbp) at ($(b)!0.291!(p)$); % 0.291 seems to best hide the midpoint discrepancy
        \vertex (midtpast) at ($(t)!0.291!(past)$);
        \vertex (eqanchor) at ($(t)!0.5!(b)$); % Anchor for inline equations
    \end{scope}
    \diagram*{
        (q) --[fermion, momentum'={[arrow style=PineGreen]\(p_1\)}] (t)
        -- [fermion, momentum'={[arrow style=BrickRed]\(k-p_2\)}] (b)
        -- [fermion, reversed momentum'={[arrow style=PineGreen]\(p_2\)}] (qbar);
        (t) -- [boson] (past);
        (midtpast) -- [opacity=0.0, momentum={[arrow style=BrickRed]\(q\)}] (past);
        (b) -- [boson] (p);
        (midbp) -- [opacity=0.0, momentum'={[arrow style=PineGreen]\(k\)}] (p);
    };
\end{feynman}