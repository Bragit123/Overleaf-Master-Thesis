\begin{feynman}
    \begin{scope}[node distance=1.4cm]
        \vertex (v2);
        \vertex [left=of v2, blob] (v1) {};
        \vertex [above left=of v1, label=left:\(q\)] (q);
        \vertex [below left=of v1, label=left:\(\bar{q}\)] (qbar);
        \vertex [above right=of v2, label=right:\(\slepton^*_{iB}\)] (lB);
        \vertex [below right=of v2, label=right:\(\slepton_{iA}\)] (lA);
        \vertex [above right=of v1] (p); % Emitted photon
    \end{scope}
    \diagram*{
        (q) --[fermion, momentum={[arrow style=PineGreen]\(p_1\)}] (v1)
        --[fermion, reversed momentum={[arrow style=PineGreen]\(p_2\)}] (qbar);
        (v1) --[boson, edge label'=\(\gamma / Z\), momentum={[arrow style=BrickRed]\(q\)}] (v2);
        (v1) --[photon, color=gray!50, momentum={[arrow style=gray!50]\(k\)}] (p);
        (v2) --[anti charged scalar, momentum={[arrow style=PineGreen]\(k_1\)}] (lB);
        (v2) --[charged scalar, momentum'={[arrow style=PineGreen]\(k_2\)}] (lA);
    };
\end{feynman}