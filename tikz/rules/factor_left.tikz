\begin{feynman}
    \begin{scope}[node distance=1.4cm]
        \vertex[blob] (v) {};
        \vertex[above left=of v, label=left:\(q\)] (q);
        \vertex[below left=of v, label=left:\(\bar{q}\)] (qbar);
        \vertex[right=of v, label=right:\(\gamma/Z\)] (p);
    \end{scope}
    \diagram*{
        (q) --[fermion, momentum={[arrow style=teal]\(p_1\)}] (v) --[fermion, reversed momentum={[arrow style=teal]\(p_2\)}] (qbar);
        (v) --[photon, momentum={[arrow style=orange]\(q\)}] (p);
    };
\end{feynman}