\begin{feynman}
    \begin{scope}
    % \begin{scope}[small, node distance=0.7cm]
        \vertex[label=left:\(\gamma/Z\)] (p);
        \vertex[right=of p, blob] (v) {};
        \vertex[above right=of v, label=right:\(\slepton_{iB}^*\)] (lB);
        \vertex[below right=of v, label=right:\(\slepton_{iA}\)] (lA);
    \end{scope}
    \diagram*{
        (p) --[photon, momentum={[arrow style=orange]\(p\)}] (v);
        (lB) --[charged scalar, reversed momentum'={[arrow style=teal]\(k_1\)}] (v)
         --[charged scalar, momentum'={[arrow style=teal]\(k_2\)}] (lA);
    };
\end{feynman}