\begin{feynman}
    \begin{scope}[small]
        \vertex[label=left:\(\gamma^*\)] (peff);
        \vertex[below right=of peff] (v);
        \vertex[above right=of v, label=right:\(\slepton_{iB}^*\)] (lB);
        \vertex[below right=of v, label=right:\(\slepton_{iA}\)] (lA);
        \vertex[below left=of v, label=left:\(\gamma\)] (p);
    \end{scope}
    \diagram*{
        (peff) --[photon] (v) --[photon] (p);
        (lB) --[charged scalar] (v)
         --[charged scalar] (lA);
    };
\end{feynman}