\begin{feynman}
    \begin{scope}[node distance=1cm]
        \vertex (v);
        \vertex[left=of v, label=left:\(\gamma^*\)] (p);
        \vertex[above right=of v, label=right:\(\bar{q}\)] (q);
        \vertex[below right=of v, label=right:\(q\)] (qbar);
    \end{scope}
    \diagram*{
        (q) --[fermion] (v) --[fermion] (qbar);
        (v) --[photon] (p);
    };
\end{feynman}