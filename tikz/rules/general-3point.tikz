\begin{feynman}
    \begin{scope}[node distance=1.4cm]
        \vertex (v); % Vertex
        \vertex[left=of v, label=left:\(V_\mu\)] (i); % Photon
        \vertex[above right=of v, label=right:\(s_1\)] (f1); % Slepton
        \vertex[below right=of v, label=right:\(s_2^*\)] (f2); % Conjugate slepton
    \end{scope}
    \diagram*{
        (i) --[photon] (v);
        (v) --[anti charged scalar, rmomentum={[arrow style=NavyBlue]\(p\)}] (f1);
        (v) --[charged scalar, momentum'={[arrow style=NavyBlue]\(p'\)}] (f2);
    };
\end{feynman}