\begin{feynman}
    \begin{scope}[node distance=1cm]
        \vertex[label=left:\(\gamma^*\)] (p);
        \vertex[right=of p] (v);
        \vertex[above right=of v, label=right:\(\slepton_{iB}^*\)] (lB);
        \vertex[below right=of v, label=right:\(\slepton_{iA}\)] (lA);
    \end{scope}
    \diagram*{
        (p) --[photon] (v);
        (v) --[anti charged scalar, momentum={[arrow style=NavyBlue]\(k_1\)}] (lB);
        (v) --[charged scalar, momentum'={[arrow style=NavyBlue]\(k_2\)}] (lA);
    };
\end{feynman}