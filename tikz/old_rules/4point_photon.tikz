\begin{feynman}
  \begin{scope}[node distance=1.4cm]
    \vertex (v);
    \vertex[left=of v, label=left:\(\gamma_\mu\)] (l);
    \vertex[right=of v, label=right:\(\gamma_\nu\)] (r);
    \vertex[above=of v, label=right:\(\tilde{\ell}_{iB}\)] (u);
    \vertex[below=of v, label=right:\(\tilde{\ell}_{iA}\)] (d);
  \end{scope}
  \diagram*{
    (l) -- [boson] (v) -- [boson] (r);
    (u) -- [charged scalar] (v) -- [charged scalar] (d);
  };
\end{feynman}