\begin{feynman}
    \begin{scope}[node distance=0.7cm]
        \vertex (v); % Vertex
        \vertex[above left=of v, label=left:\(W^+_\mu\)] (i1); % Photon
        \vertex[below left=of v, label=left:\(\gamma_\nu\)] (i2); % Photon
        \vertex[above right=of v, label=right:\(\tilde\ell_{iA}\)] (f1); % Slepton
        \vertex[below right=of v, label=right:\(\tilde\nu_{iL}^*\)] (f2); % Conjugate slepton
    \end{scope}
    \diagram*{
        (i1) --[photon] (v) --[photon] (i2);
        (f1) --[charged scalar] (v) --[charged scalar] (f2);
    };
\end{feynman}