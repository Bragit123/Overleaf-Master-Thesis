\tikzset{>={Stealth[scale=1]}}

\coordinate (0) at (0,0);
\coordinate (p2) at (2,0);
\coordinate (p1) at ($(0)-(p2)$);
\coordinate (k) at (2,0.8);
\coordinate (q) at ($(0)-(k)$);

\draw[->] (0) -- (2.5,0) node[right] {$z$};
\draw[->] (0) -- (0,1.4) node[above] {$x$};
\draw[BrickRed, ->] (p1) -- (0) node[above left] {$\vec{p}_1$};
\draw[BrickRed, ->] (p2) -- (0) node[below right] {$\vec{p}_2$};
\draw[NavyBlue, ->] (0) -- (k) node[right] {$\vec{k}$};
\draw[PineGreen, ->] (0) -- (q) node[left] {$\vec{q}$};
\pic[draw, Purple, angle eccentricity=1.3, angle radius=1cm, pic text=$\theta$] {angle= p2--0--k};