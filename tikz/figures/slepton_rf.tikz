\tikzset{>={Stealth[scale=1]}}

\coordinate (0) at (0,0,0);
\coordinate (k) at (2,0,0);
\coordinate (p) at (-2,0,0);
\coordinate (k1) at (2.5,2,3);
\coordinate (k1xy) at (0,2,3);
\coordinate (k1x) at (0,2,0);
\coordinate (k1y) at (0,0,3);
\coordinate (k2) at ($(0)-(k1)$);
\coordinate (z) at (2.5,0,0);
\coordinate (x) at (0,2.2,0);
\coordinate (y) at (0,0,3.3);

\draw[->] (0) -- (z) node[right] {$z^*$};
\draw[->] (0) -- (x) node[right] {$x^*$};
\draw[->] (0) -- (y) node[left] {$y^*$};
\draw[BrickRed, ->] (p) node[above right] {$\vec{p}^*$} -- (0);
\draw[NavyBlue, ->] (0) -- (k) node[above] {$\vec{k}^*$};
\draw[PineGreen, ->] (0) -- (k1) node[above] {$\vec{k}_1^*$};
\draw[PineGreen, ->] (0) -- (k2) node[left] {$\vec{k}_2^*$};
\draw[dashed] (k1) -- (k1xy);
\draw[dashed] (0) -- (k1xy);
\draw[dashed] (k1x) -- (k1xy);
\draw[dashed] (k1y) -- (k1xy);
\pic[draw, Purple, angle eccentricity=1.5, angle radius=0.7cm, pic text=$\theta^*$] {angle= z--0--k1};
\pic[draw, Purple, angle eccentricity=1.5, angle radius=0.4cm, pic text=$\phi^*$] {angle= x--0--k1xy};